{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-dataset.schema.json",
  "title": "Coordinator-reviewed tutor matching evaluation dataset",
  "type": "object",
  "required": ["schemaVersion", "datasetId", "labelingStatus", "labelRubric", "queries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetId": { "type": "string", "minLength": 1 },
    "labelingStatus": { "enum": ["coordinator_reviewed", "synthetic_unit_test"] },
    "split": { "enum": ["train", "validation", "test", "development"] },
    "labelRubric": {
      "type": "object",
      "required": ["relevantThreshold", "grades"],
      "properties": {
        "relevantThreshold": { "const": 2 },
        "grades": {
          "type": "object",
          "required": ["0", "1", "2", "3"],
          "properties": {
            "0": { "type": "string", "minLength": 1 },
            "1": { "type": "string", "minLength": 1 },
            "2": { "type": "string", "minLength": 1 },
            "3": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["queryId", "studentRecord", "tutorRecords", "judgments"],
        "properties": {
          "queryId": { "type": "string", "minLength": 1 },
          "studentRecord": { "type": "object", "required": ["id"] },
          "tutorRecords": {
            "type": "array",
            "items": { "type": "object", "required": ["id"] }
          },
          "assignments": { "type": "array", "items": { "type": "object" } },
          "labelingMetadata": {
            "type": "object",
            "required": ["rubricVersion", "reviewerRole", "reviewerCount", "adjudicated"],
            "properties": {
              "rubricVersion": { "type": "string", "minLength": 1 },
              "reviewerRole": { "enum": ["COORDINATOR", "DOMAIN_EXPERT"] },
              "reviewerCount": { "type": "integer", "minimum": 1 },
              "adjudicated": { "const": true }
            },
            "additionalProperties": false
          },
          "judgments": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 3 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "labelingStatus": { "const": "coordinator_reviewed" } } },
      "then": {
        "properties": {
          "queries": {
            "items": { "required": ["labelingMetadata"] }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
