FROM node:22-bookworm-slim AS node
FROM catthehacker/ubuntu:act-latest
COPY --from=node /usr/local/bin/node /usr/local/bin/node
ENV PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
# Only system services are stubbed; Gitea, PostgreSQL and API writes are real.
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/systemctl \
    && cp /usr/local/bin/systemctl /usr/local/bin/nginx \
    && cp /usr/local/bin/systemctl /usr/local/bin/cloudflared \
    && cp /usr/local/bin/systemctl /usr/local/bin/rsync \
    && chmod 755 /usr/local/bin/systemctl /usr/local/bin/nginx /usr/local/bin/cloudflared /usr/local/bin/rsync \
    && mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled \
    && useradd -m runner
WORKDIR /workspace
