# Copy to .env.local and fill only the providers you want to enable.
# Every VITE_* value is bundled into public browser code. Use public client
# identifiers only; never put a server/API secret in this file.
VITE_BACKEND_URL=http://localhost:4000/api
VITE_OBSERVABILITY_ENV=development
VITE_OBSERVABILITY_RELEASE=

# Datadog RUM enables when both values are set.
VITE_DATADOG_APPLICATION_ID=
VITE_DATADOG_CLIENT_TOKEN=
VITE_DATADOG_SITE=datadoghq.com
VITE_DATADOG_SESSION_SAMPLE_RATE=100
VITE_DATADOG_DASHBOARD_URL=

# Sentry enables when a browser project DSN is set.
VITE_SENTRY_DSN=
VITE_SENTRY_DASHBOARD_URL=

# Grafana Faro enables when the Web SDK collector URL is set.
VITE_GRAFANA_FARO_URL=
VITE_GRAFANA_APP_NAME=code-pulse-frontend
VITE_GRAFANA_SESSION_SAMPLING_RATE=1
VITE_GRAFANA_DASHBOARD_URL=
